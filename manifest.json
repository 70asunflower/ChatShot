{
  "manifest_version": 3,
  "name": "ChatShot",
  "version": "1.5.0",
  "description": "Capture AI chat responses as screenshots and stitch them for easy sharing",
  "permissions": ["activeTab", "clipboardWrite"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start block selection on the current AI chat page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://notebooklm.google.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://www.qianwen.com/*",
        "https://chatglm.cn/*",
        "https://copilot.microsoft.com/*",
        "https://chat.qwen.ai/*",
        "https://claude.ai/*"
      ],
      "js": ["lib/html-to-image.js", "adapters.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logos/*.png", "lib/katex.min.css"],
      "matches": [
        "https://chat.deepseek.com/*",
        "https://notebooklm.google.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://www.qianwen.com/*",
        "https://chatglm.cn/*",
        "https://copilot.microsoft.com/*",
        "https://chat.qwen.ai/*",
        "https://claude.ai/*"
      ]
    }
  ]
}
